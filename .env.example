AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR-KEY
# Optional fallback when no text deployment is saved in Script Generation (not a Realtime judge deployment).
# SCRIPT_GENERATION_DEPLOYMENT=YOUR-TEXT-DEPLOYMENT
# Actual Azure deployment names, not necessarily model names. Edit in the app too.
JUDGE_DEPLOYMENTS=gpt-realtime-1.5,gpt-realtime,gpt-realtime-mini,gpt-realtime-2.1-mini,gpt-realtime-2.1
# Optional: enable shared scoring slots within the active evaluation (default: 1).
# VOICE_CLIP_CONCURRENCY=2
PORT=4310
# Optional public HTTPS URL for the Arena scorecard's Share External link (set before building).
# VITE_ARENA_EXTERNAL_SCORECARD_URL=https://YOUR-ACCOUNT.github.io/YOUR-REPO/scorecard/
# Optional data directory override. Default: %LOCALAPPDATA%\VoiceQualityWorkbench\data
# Keep this outside OneDrive or other synced folders if recordings are sensitive.
# VOICE_DATA_DIR=C:\VoiceLabData
# Optional separate Azure Speech resource for Azure Voices Studio.
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_KEY=YOUR-SPEECH-KEY
# AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH-RESOURCE.cognitiveservices.azure.com
